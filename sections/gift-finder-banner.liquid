{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .gift-finder-banner {
    text-align: center;
  }

  .gift-finder-banner__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2.5rem;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding gift-finder-banner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="gift-finder-banner__ctas">
      {%- for block in section.blocks -%}
        {%- if block.settings.label != blank -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="button{% if forloop.index > 1 %} button--secondary{% else %} button--primary{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label | escape }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.gift_finder_banner.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.gift_finder_banner.settings.heading.default",
      "label": "t:sections.gift_finder_banner.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.gift_finder_banner.settings.text.default",
      "label": "t:sections.gift_finder_banner.settings.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "t:sections.gift_finder_banner.blocks.cta.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.gift_finder_banner.blocks.cta.settings.label.default",
          "label": "t:sections.gift_finder_banner.blocks.cta.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.gift_finder_banner.blocks.cta.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.gift_finder_banner.presets.name",
      "blocks": [
        { "type": "cta" },
        { "type": "cta" },
        { "type": "cta" }
      ]
    }
  ]
}
{% endschema %}
