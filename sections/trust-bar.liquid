{%- style -%}
  .trust-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.6rem 3.2rem;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .trust-bar__item .icon {
    width: 2.2rem;
    height: 2.2rem;
    flex-shrink: 0;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width trust-bar">
    {%- for block in section.blocks -%}
      {%- assign icon_file = block.settings.icon | replace: '_', '-' | prepend: 'icon-' | append: '.svg' -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="icon">{{ icon_file | inline_asset_content }}</span>
        <span>{{ block.settings.text | escape }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.trust_bar.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_bar.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "truck", "label": "t:sections.trust_bar.blocks.item.settings.icon.options__1.label" },
            { "value": "lock", "label": "t:sections.trust_bar.blocks.item.settings.icon.options__2.label" },
            { "value": "return", "label": "t:sections.trust_bar.blocks.item.settings.icon.options__3.label" },
            { "value": "price_tag", "label": "t:sections.trust_bar.blocks.item.settings.icon.options__4.label" },
            { "value": "check_mark", "label": "t:sections.trust_bar.blocks.item.settings.icon.options__5.label" }
          ],
          "default": "check_mark",
          "label": "t:sections.trust_bar.blocks.item.settings.icon.label"
        },
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.trust_bar.blocks.item.settings.text.default",
          "label": "t:sections.trust_bar.blocks.item.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_bar.presets.name",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck" } },
        { "type": "item", "settings": { "icon": "lock" } },
        { "type": "item", "settings": { "icon": "return" } },
        { "type": "item", "settings": { "icon": "price_tag" } }
      ]
    }
  ]
}
{% endschema %}
