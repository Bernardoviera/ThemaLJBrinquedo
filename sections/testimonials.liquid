{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }

  @media screen and (min-width: 750px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonials__card {
    border-radius: {{ settings.card_corner_radius }}px;
    background: rgb(var(--color-background));
    box-shadow: 0 0.1rem 0.3rem rgba(var(--color-shadow), 0.15);
    padding: 2.4rem;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    margin-bottom: 1.2rem;
  }

  .testimonials__stars .icon-wrapper .icon {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
  }

  .testimonials__stars .icon-wrapper:not(.is-filled) .icon {
    opacity: 0.25;
  }

  .testimonials__quote {
    margin: 0 0 1.6rem;
  }

  .testimonials__author {
    font-weight: 600;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    <ul class="testimonials__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="testimonials__card" {{ block.shopify_attributes }}>
          <div class="testimonials__stars" role="img" aria-label="{{ block.settings.rating }}/5">
            {%- for i in (1..5) -%}
              <span class="icon-wrapper{% if i <= block.settings.rating %} is-filled{% endif %}">
                {{- 'icon-star.svg' | inline_asset_content -}}
              </span>
            {%- endfor -%}
          </div>
          <blockquote class="testimonials__quote rte">{{ block.settings.quote }}</blockquote>
          <p class="testimonials__author">{{ block.settings.author | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.testimonials.settings.title.default",
      "label": "t:sections.testimonials.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:sections.testimonials.blocks.review.name",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "t:sections.testimonials.blocks.review.settings.rating.label"
        },
        {
          "type": "richtext",
          "id": "quote",
          "default": "t:sections.testimonials.blocks.review.settings.quote.default",
          "label": "t:sections.testimonials.blocks.review.settings.quote.label"
        },
        {
          "type": "text",
          "id": "author",
          "default": "t:sections.testimonials.blocks.review.settings.author.default",
          "label": "t:sections.testimonials.blocks.review.settings.author.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
