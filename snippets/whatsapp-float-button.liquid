{% comment %}
  Renders a floating WhatsApp contact button, fixed bottom-right.
  Controlled by theme settings: whatsapp_button_enable, whatsapp_button_phone,
  whatsapp_button_message.
{% endcomment %}
{%- if settings.whatsapp_button_enable and settings.whatsapp_button_phone != blank -%}
  {%- assign wa_digits = settings.whatsapp_button_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+' -%}
  {%- style -%}
    .whatsapp-float-button {
      position: fixed;
      z-index: 100;
      right: 1.6rem;
      bottom: 1.6rem;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 5.6rem;
      height: 5.6rem;
      border-radius: 50%;
      background: #25D366;
      box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.25);
      color: #ffffff;
      text-decoration: none;
    }

    .whatsapp-float-button:hover {
      filter: brightness(0.95);
    }

    .whatsapp-float-button svg {
      width: 2.8rem;
      height: 2.8rem;
      fill: currentColor;
    }

    @media screen and (max-width: 749px) {
      .whatsapp-float-button {
        right: 1.2rem;
        bottom: 1.2rem;
        width: 5rem;
        height: 5rem;
      }
    }
  {%- endstyle -%}

  <a
    class="whatsapp-float-button"
    href="https://wa.me/{{ wa_digits }}?text={{ settings.whatsapp_button_message | url_param_escape }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="{{ 'general.whatsapp_button.aria_label' | t }}"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M17.472 14.382c-.297-.149-1.758-.868-2.03-.967-.273-.099-.472-.148-.67.15-.198.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.148-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479s1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12.004 2c-5.514 0-9.997 4.483-9.997 9.997 0 1.763.462 3.486 1.34 5.006L2 22l5.13-1.335a9.96 9.96 0 0 0 4.874 1.242h.004c5.514 0 9.997-4.483 9.997-9.997C21.997 6.483 17.518 2 12.004 2Zm0 18.19h-.004a8.19 8.19 0 0 1-4.171-1.14l-.299-.177-3.043.792.812-2.966-.194-.304a8.19 8.19 0 0 1-1.257-4.398c0-4.53 3.687-8.216 8.16-8.216 4.474 0 8.16 3.687 8.16 8.216 0 4.53-3.686 8.193-8.164 8.193Z"/>
    </svg>
  </a>
{%- endif -%}
